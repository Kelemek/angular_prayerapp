#!/bin/sh
# Reports Supabase changes the GitHub Integration will not deploy. Never blocks the push.
command -v node >/dev/null 2>&1 || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  node scripts/supabase-deploy-gaps.mjs "$remote_sha" "$local_sha" || true
done
exit 0
